# SyllabiQ Environment Configuration Template
# Built by Harbour & Main (2026)

# Next.js Public App URL
NEXT_PUBLIC_APP_URL=https://syllabiq.ca

# Server-backed auth and Prisma persistence
DATABASE_URL=postgresql://user:password@host:5432/syllabiq?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAILS=admin@example.com

# Stripe Billing (https://dashboard.stripe.com/apikeys)
# REAL BILLING SETUP (required for Pro checkout to work):
#  1. In the Stripe dashboard, create a Product "SyllabiQ Pro" with a
#     recurring Price of $5/month -> copy its Price ID (price_...).
#  2. Set STRIPE_SECRET_KEY to a Restricted or Secret key, and
#     STRIPE_PRICE_ID to that Price ID, in Vercel env vars.
#  3. In Stripe dashboard -> Developers -> Webhooks, add endpoint
#     https://syllabiq.ca/api/stripe/webhook listening for:
#     checkout.session.completed, customer.subscription.created,
#     customer.subscription.updated, customer.subscription.deleted
#     -> copy the Signing secret into STRIPE_WEBHOOK_SECRET.
# NOTE: checkout uses trial_period_days=30, so the card is collected at
# signup but the first $5 charge happens 30 days later ("first month free").
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Google AI Gemini Multimodal Vision (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...

# Google Cloud Storage Vault
GCS_BUCKET_NAME=syllabiq-academic-vault
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# Google OAuth2 Credentials (Google Sign In & Drive API)
GOOGLE_CLIENT_ID=437142939106-...apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=437142939106-...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Twilio Real Mobile SMS Alerts (https://console.twilio.com/)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+18005550199

# Vercel Deployment Token (if deploying via CLI)
# VERCEL_TOKEN=...
